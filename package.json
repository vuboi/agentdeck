{
  "name": "agentdeck",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/run-desktop.mjs dev",
    "dev:update": "node scripts/run-desktop.mjs dev --fake-update",
    "dev:linux": "node scripts/run-desktop.mjs dev",
    "build": "node scripts/build.mjs",
    "build:win": "node scripts/build.mjs win",
    "build:mac": "node scripts/build.mjs mac",
    "build:linux": "node scripts/build.mjs linux",
    "check": "node scripts/cargo.mjs check --workspace && node scripts/cargo.mjs clippy --workspace -- -D warnings && pnpm -r check",
    "test": "node scripts/cargo.mjs test --workspace && pnpm -r --if-present test",
    "clean:junk": "node scripts/clean-junk.mjs",
    "clean:junk:delete": "node scripts/clean-junk.mjs --delete",
    "hooks:install": "git config core.hooksPath .githooks",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:types": "node scripts/cargo.mjs run -q -p ag-protocol --example export_ts",
    "format": "prettier --write .",
    "dev:web": "node scripts/run-desktop.mjs web",
    "run:build": "node scripts/run-desktop.mjs build"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.30.1",
      "@tiptap/extension-bubble-menu": "3.30.1",
      "@tiptap/extension-code": "3.30.1",
      "@tiptap/extension-horizontal-rule": "3.30.1",
      "@tiptap/extension-image": "3.30.1",
      "@tiptap/extension-link": "3.30.1",
      "@tiptap/extension-mention": "3.30.1",
      "@tiptap/extension-placeholder": "3.30.1",
      "@tiptap/extension-text-align": "3.30.1",
      "@tiptap/extension-text-style": "3.30.1",
      "@tiptap/extension-underline": "3.30.1",
      "@tiptap/markdown": "3.30.1",
      "@tiptap/pm": "3.30.1",
      "@tiptap/starter-kit": "3.30.1"
    }
  }
}
