{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDeck",
  "version": "0.0.0",
  "identifier": "dev.agentdeck.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "AgentDeck", "width": 1280, "height": 800, "minWidth": 320, "minHeight": 480, "center": true, "decorations": false, "transparent": true }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://cdn.jsdelivr.net https://thesvg.org ws://127.0.0.1:*",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://cdn.jsdelivr.net https://thesvg.org http://127.0.0.1:1420 ws://127.0.0.1:* ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installerIcon": "icons/icon.ico", "template": "windows/installer.nsi" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBRTFGRDY5Qjk3RjhBQjYKUldTMmluKzVhZjNoeW1JWFp5alpnVXExVDkwRGlMMEc1djRUaFpyNGZBMGtFN00vTzUvOUZCYUYK",
      "endpoints": ["https://github.com/vuboi/agentdeck/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
